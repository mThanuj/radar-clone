# ── Database (required) ─────────────────────────────────────────────────────
# DATABASE_URL  — POOLED endpoint (host contains "-pooler"). Used at runtime by
#                 the Neon driver adapter in src/lib/db.ts.
# DIRECT_URL    — UNPOOLED endpoint. Used by prisma.config.ts for migrations;
#                 the schema engine can't run DDL through pgbouncer.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/radar?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/radar?sslmode=require"

# ── Auth (required) ─────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-random-bytes"
# Optional on Vercel — the app derives the host per environment from the
# VERCEL_* system variables. Set it locally.
BETTER_AUTH_URL="http://localhost:3000"

# ── Email (required) ────────────────────────────────────────────────────────
# Gmail: Google Account → Security → 2-Step Verification → App passwords.
# Generate one for "Radar"; it's 16 characters, shown once. Use it here, not
# your normal Google password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="abcdefghijklmnop"
SMTP_FROM="Radar <you@gmail.com>"

# Set to "json" to render messages to the console instead of sending them.
# The test suite sets this automatically; useful locally when you don't want
# a real inbox full of test mail.
# EMAIL_TRANSPORT="json"

# ── Realtime (required) ─────────────────────────────────────────────────────
# console.upstash.com → Create Database (Redis) → REST API section.
# Copy both values; the token is the read-write one.
UPSTASH_REDIS_REST_URL="https://your-db-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-me"

# ── Cron (required in production) ───────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`. Without it
# the cron endpoints refuse every request rather than running open.
# openssl rand -hex 24
CRON_SECRET=""

# ── Seed ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="change-this-locally"
SEED_ADMIN_NAME="Your Name"
SEED_ADMIN_HANDLE="yourhandle"
