{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:reset": "node scripts/migrate.mjs --reset && npm run db:seed",
    "db:seed": "node --env-file=.env --import tsx/esm prisma/seed.mts",
    "db:sql": "node scripts/sql.mjs",
    "postinstall": "prisma generate",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "build:check": "next build --webpack",
    "lockfile:normalize": "node scripts/normalize-lockfile.mjs",
    "check:origins": "node --conditions=react-server --env-file=.env --import tsx/esm scripts/check-origins.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@shikijs/rehype": "^4.4.3",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "hast-util-sanitize": "^5.0.2",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fast-check": "^4.10.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
